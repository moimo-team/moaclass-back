generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Attendance {
  PENDING
  ATTENDANCE
  ABSENT
}

enum ParticipationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum LessonStatus {
  ACTIVE
  INACTIVE
  DELETED
  DRAFT
  DUPLICATED
}

enum LessonScheduleStatus {
  RECRUITING
  CLOSED
  COMPLETED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationType {
  PARTICIPATION_REQUEST
  PARTICIPATION_ACCEPTED
  PARTICIPATION_REJECTED
  PARTICIPATION_CANCELLED
  MEETING_DELETED

  COMMENT_ON_LESSON
  REPLY_ON_COMMENT
  PAYMENT_SUCCESS
  PAYMENT_CANCELLED
  LESSON_CANCELLED
  REMINDER_24H
  REMINDER_1H
  REVIEW_REQUEST
  NEW_CHAT
}

enum ProviderType {
  GOOGLE
  KAKAO
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum PointType {
  CHARGE
  USE
  REFUND
}

enum DiscountType {
  FIXED
  PERCENT
}

//검토완료
model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  nickname     String       @unique
  provider     ProviderType
  providerId   String       @unique @map("provider_id")
  bio          String?      @db.Text
  image        String?
  point        Int          @default(0)
  resetToken   String?      @map("reset_token")
  refreshToken String?      @unique @map("refresh_token")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  regionId Int?    @map("region_id")
  region   Region? @relation(fields: [regionId], references: [id])

  teacherProfile    TeacherProfile?  
  interests         UserInterest[]
  hostedMeetings    Meeting[]          @relation("HostedMeetings")
  participations    Participation[]
  enrollments       Enrollment[]
  notificationsRec  Notification[]     @relation("Receiver")
  notificationsSend Notification[]     @relation("Sender")
  reviews           Review[]
  wishlists         Wishlist[]
  pointTransactions PointTransaction[]
  userCoupons       UserCoupon[]
  lessons           Lesson[]           @relation("UserLessons")

  @@map("users")
}


model Region {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  users   User[]
  lessons Lesson[]

  @@map("regions")
}

model LessonCategory {
  id            Int                 @id @default(autoincrement())
  name          String              @unique
  subCategories LessonSubCategory[]
  lessons       Lesson[]
  userInterests UserInterest[]

  @@map("lesson_categories")
}

model LessonSubCategory {
  id         Int    @id @default(autoincrement())
  categoryId Int    @map("category_id")
  name       String

  category LessonCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  lessons LessonSubCategoryMap[]

  @@map("lesson_sub_categories")
}

model MeetingCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  meetings Meeting[]

  @@map("meeting_categories")
}

model UserInterest {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  lessonCategoryId Int      @map("lesson_category_id")
  createdAt        DateTime @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id])
  lessonCategory LessonCategory @relation(fields: [lessonCategoryId], references: [id])

  @@unique([userId, lessonCategoryId])
  @@map("user_interests")
}

model TeacherProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  nickname     String   @unique @map("nickname")
  image        String
  introduction String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("teacher_profiles")
}


model Meeting {
  id                  Int      @id @default(autoincrement())
  title               String   @db.VarChar(100)
  description         String   @db.VarChar(4000)
  currentParticipants Int      @default(1) @map("current_participants")
  maxParticipants     Int      @map("max_participants")
  meetingDate         DateTime @map("meeting_date")
  image               String?
  categoryId          Int      @map("category_id")
  address             String   @db.Text
  latitude            Float
  longitude           Float
  meetingDeleted      Boolean  @default(false) @map("meeting_deleted")
  hostId              Int      @map("host_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  host           User            @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  category       MeetingCategory @relation(fields: [categoryId], references: [id])
  participations Participation[]
  notifications  Notification[]

  @@map("meetings")
}

model Participation {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  meetingId Int                 @map("meeting_id")
  status    ParticipationStatus @default(PENDING)
  checkedIn Attendance          @default(PENDING) @map("checked_in")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@map("participations")
}

model Lesson {
  id               Int    @id @default(autoincrement())
  userId           Int    @map("user_id")
  lessonCategoryId Int    @map("lesson_category_id")
  title            String @db.VarChar(50)
  description      String @db.Text
  level            Level
  durationSec      Int    @map("duration_sec")
  curriculum       String @db.Text

  status          LessonStatus @default(ACTIVE)
  price           Int          @default(0)
  discountRate    Int          @default(0) @map("discount_rate")
  discountedPrice Int          @default(0) @map("discounted_price")

  maxParticipants     Int    @map("max_participants")
  representativeImage String @map("representative_image")
  likeCount           Int    @default(0) @map("like_count")

  regionId       Int    @map("region_id")
  address        String
  latitude       Float
  longitude      Float
  detailAddress  String @map("detail_address")
  directionsText String @map("directions_text")

  reservationLeadDays Int @default(0) @map("reservation_lead_days")

  rate            Float     @default(0)
  deletedAt       DateTime? @map("deleted_at")
  reviewAiSummary String?   @map("review_ai_summary")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  teacher           User                 @relation("UserLessons", fields: [userId], references: [id])
  lessonCategory    LessonCategory       @relation(fields: [lessonCategoryId], references: [id])
  region            Region               @relation(fields: [regionId], references: [id])
  images            LessonImage[]
  schedules         LessonSchedule[]
  notifications     Notification[]
  reviews           Review[]
  wishlists         Wishlist[]
  pointTransactions PointTransaction[]

  subCategories LessonSubCategoryMap[]

  @@map("lessons")
}

model LessonSchedule {
  id                  Int                  @id @default(autoincrement())
  lessonId            Int                  @map("lesson_id")
  startAt             DateTime             @map("start_at")
  endAt               DateTime             @map("end_at")
  currentParticipants Int                  @default(0) @map("current_participants")
  status              LessonScheduleStatus @default(RECRUITING)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([lessonId, startAt, endAt])
  @@map("lesson_schedules")
}

model LessonImage {
  id       Int    @id @default(autoincrement())
  lessonId Int    @map("lesson_id")
  image    String @map("image")
  sequence Int

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@map("lesson_images")
}

model LessonSubCategoryMap {
  id            Int @id @default(autoincrement())
  lessonId      Int @map("lesson_id")
  subCategoryId Int @map("sub_category_id")

  lesson      Lesson            @relation(fields: [lessonId], references: [id])
  subCategory LessonSubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([lessonId, subCategoryId])
  @@map("lesson_sub_categories_map")
}

model Enrollment {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @map("user_id")
  scheduleId         Int                 @map("schedule_id")
  status             ParticipationStatus
  checkedIn          Attendance          @default(PENDING) @map("checked_in")
  pointTransactionId Int                 @map("point_transaction_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id])
  schedule    LessonSchedule   @relation(fields: [scheduleId], references: [id])
  transaction PointTransaction @relation(fields: [pointTransactionId], references: [id])

  @@unique([userId, scheduleId])
  @@map("enrollments")
}

model Notification {
  id         Int  @id @default(autoincrement())
  lessonId   Int? @map("lesson_id")
  meetingId  Int? @map("meeting_id")
  receiverId Int  @map("receiver_id")
  senderId   Int? @map("sender_id")

  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  lesson   Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  receiver User     @relation("Receiver", fields: [receiverId], references: [id])
  sender   User?    @relation("Sender", fields: [senderId], references: [id])

  @@map("notifications")
}

model Review {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  lessonId            Int      @map("lesson_id")
  representativeImage String?  @map("representative_image")
  rating              Int
  content             String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id])
  lesson Lesson        @relation(fields: [lessonId], references: [id])
  images ReviewImage[]

  @@map("reviews")
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId Int    @map("review_id")
  image    String @map("image")
  sequence Int

  review Review @relation(fields: [reviewId], references: [id])

  @@map("review_images")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  lessonId  Int      @map("lesson_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("wishlists")
}

model PointTransaction {
  id           Int               @id @default(autoincrement())
  userId       Int               @map("user_id")
  lessonId     Int               @map("lesson_id")
  couponId     Int?              @map("coupon_id")
  amount       Int
  type         PointType
  status       TransactionStatus
  reason       String?
  detailReason String?            @map("detail_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
  lesson Lesson  @relation(fields: [lessonId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
  enrollments Enrollment[]

  @@map("point_transactions")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  description   String?
  discountType  DiscountType
  discountValue Int      @map("discount_value")
  maxUsage      Int      @map("max_usage")
  currentUsage  Int      @default(0) @map("current_usage")
  validFrom     DateTime @map("valid_from")
  validUntil    DateTime @map("valid_until")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  userCoupons       UserCoupon[]
  pointTransactions PointTransaction[]

  @@map("coupons")
}

model UserCoupon {
  id       Int       @id @default(autoincrement())
  userId   Int       @map("user_id")
  couponId Int       @map("coupon_id")
  isUsed   Boolean   @default(false) @map("is_used")
  usedAt   DateTime? @map("used_at")
  issuedAt DateTime  @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@map("user_coupons")
}
